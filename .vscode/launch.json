{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug ft_ssl",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/ft_ssl",
      "args": [
        "md5",
        "-s",
        "pity those that aren't following baerista on spotify."
